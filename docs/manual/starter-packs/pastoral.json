      "steps": [
        "Read the passage and sit with it",
        "Pull commentaries and cross-references",
        "Draft sermon outline",
        "Write opening and closing",
        "Practice / rehearse delivery",
        "Send title and notes to AV by Friday"
      ]
    },
    {
      "title": "Pastoral visits and care touchpoints",
      "cadence": "weekly",
      "steps": [
        "Review who's on the care list",
        "Reach out to 3-5 people this week",
        "Log conversations and follow-ups"
      ]
    },
    {
      "title": "Elder / leadership meeting prep",
      "cadence": "monthly",
      "steps": [
        "Send agenda-items request to elders",
        "Compile agenda",
        "Distribute meeting notes ahead of time",
        "Lead meeting",
        "Send minutes within 48 hours"
      ]
    },
    {
      "title": "Vision and rhythm review",
      "cadence": "quarterly",
      "steps": [
        "Review last quarter's preaching themes",
        "Pray and plan the next quarter's preaching arc",
        "Discuss with leadership"
      ]
    }
  ],
  "projects": [
