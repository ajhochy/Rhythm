# macOS
.DS_Store

# Flutter / Dart
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/build/
**/ios/Flutter/.last_build_id
# pubspec.lock is committed for apps to ensure reproducible CI builds.
# Ignore it only for reusable packages (none in this repo currently).
# **/pubspec.lock

# Node / TypeScript
**/node_modules/
**/dist/
**/*.tsbuildinfo
npm-debug.log*

# api_server install-time runtime sentinel (issue #585)
apps/api_server/.node-runtime.json

# Local-only auth-strategy probes (read real OAuth tokens — never commit)
apps/api_server/scripts/auth-strategy-probe.ts
apps/api_server/scripts/probe-output.log

# Machine-local MCP server extensions (personal API keys — never commit)
apps/api_server/src/config/curated_mcp_servers.local.json

# IDEs
.vscode/
.idea/
*.iml

# Env
.env
.env.*

# Cloudflare Workers (wrangler local state + local secret file)
.wrangler/
.dev.vars
.dev.vars.*

# Logs
*.log
!docs/ai/evidence/logs/*.log
coverage/

# Local runtime data
rhythm.db
rhythm.db-shm
rhythm.db-wal
db-backups/

# Local scratch/output artifacts
tmp/
output/
*.state.json
.superpowers/
pipeline-evidence/

# Local planning scratch docs
docs/superpowers/plans/

# GitNexus local index
.gitnexus/

# Vendored opencode fork (apps/opencode_fork) — source is committed, build
# artifacts are not. The subtree ships its own .gitignore too; these root
# entries make the intent explicit. See
# docs/ai/decisions/2026-06-25-opencode-fork-vendoring.md
apps/opencode_fork/node_modules/
apps/opencode_fork/**/node_modules/
apps/opencode_fork/.bun/
apps/opencode_fork/.turbo/
apps/opencode_fork/**/.turbo/
apps/opencode_fork/**/dist/
apps/opencode_fork/**/ts-dist/
apps/opencode_fork/**/*.bun-build
apps/opencode_fork/.sst/
apps/opencode_fork/**/*.tsbuildinfo

# dev-only: locally-built opencode fork for smoke (issue #764)
apps/api_server/opencode_bin/
apps/opencode_bin/

# Vendored engine plugins (the compiled JS IS the source we ship) — un-ignore
# their dist/ from the global **/dist/ rule above. See
# apps/api_server/opencode_plugins/rhythm-anthropic-accounts/VENDORED.md
!apps/api_server/opencode_plugins/**/dist/

# dev-only: agent eval harness scorecards (tools/dev/agent_eval_driver.ts).
# Generated locally, may contain (redacted/truncated) transcript excerpts —
# never committed.
docs/testing/results/
.playwright-mcp/
