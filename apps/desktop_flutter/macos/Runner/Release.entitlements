<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- The bundled opencode fork (a bun standalone executable) extracts an
	     embedded native FFI dylib to a temp path and dlopen()s it at runtime
	     (its PTY backend). Under Hardened Runtime, library validation rejects
	     loading a library whose Team ID differs from the process's, which is the
	     case for opencode's re-signed binary vs. its runtime-extracted dylib
	     ("different Team IDs"). Disabling library validation lets opencode load
	     it, fixing the Agents Terminal tab ("Terminal connection failed" /
	     Pty.create 500). The opencode binary is signed with this entitlement in
	     tools/release/sign_and_notarize_macos.sh -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
