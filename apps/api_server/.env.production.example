NODE_ENV=production
PORT=4000
# #1214 — the hosted API is Postgres-backed (see AGENTS.md "Production is
# Postgres" and docs/ai/decisions/2026-07-28-scheduler-quarantine.md). Setting
# DB_CLIENT=postgres here is what makes the scheduler-ownership guard in
# agentSchedulerService.ts quarantine this deployment (never ticks/advances
# agent_scheduled_tasks) — independent of RHYTHM_ROLE below.
DB_CLIENT=postgres
DB_HOST=rhythm-postgres
DB_PORT=5432
DB_NAME=rhythm
DB_USER=rhythm_user
DB_PASSWORD=replace-with-strong-password
DB_SSL=false
# #755/#1214 — recommended: disables agent-execution routes, the opencode
# engine spawn, the WS gateway, and scheduler startup entirely on this hosted
# instance (agent_scheduled_tasks ticking is separately quarantined above by
# DB_CLIENT regardless of this value). Leave unset only if this API instance
# still intentionally doubles as an agent-execution host.
RHYTHM_ROLE=cloud
CORS_ALLOWED_ORIGINS=https://app.vcrcapps.com

GOOGLE_AUTH_CLIENT_ID=your-google-auth-client-id
GOOGLE_MOBILE_CLIENT_ID=your-google-ios-client-id
GOOGLE_MOBILE_REDIRECT_URI=com.googleusercontent.apps.your-reversed-google-client-id:/oauthredirect
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://api.vcrcapps.com/auth/google/callback
RHYTHM_GOOGLE_ALLOWED_EMAILS=
RHYTHM_GOOGLE_ALLOWED_HOSTED_DOMAINS=your-google-workspace-domain.example

PCO_APPLICATION_ID=your-pco-application-id
PCO_SECRET=your-pco-secret
PCO_REDIRECT_URI=https://api.vcrcapps.com/auth/planning-center/callback

TUNNEL_TOKEN=your-cloudflare-tunnel-token
SQLITE_MIGRATION_PATH=/data/rhythm.db

RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Rhythm <notifications@yourdomain.com>
