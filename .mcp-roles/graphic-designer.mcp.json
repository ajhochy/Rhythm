{
  "$schema": "https://rhythm.vcrcapps.com/schemas/mcp-role.json",
  "role": "graphic-designer",
  "description": "Agentic graphic designer \u2014 Canva design creation and export only. No code execution.",
  "mcpServers": {
    "canva": {
      "type": "remote",
      "url": "https://mcp.canva.com/mcp",
      "allowedTools": [
        "generate-design",
        "create-design-from-brand-template",
        "export-design",
        "get-design",
        "get-design-content",
        "get-design-pages",
        "get-design-thumbnail",
        "search-designs",
        "search-brand-templates",
        "list-brand-kits"
      ]
    },
    "obsidian": {
      "inherit": true,
      "allowedTools": [
        "obsidian_get_file",
        "obsidian_get_active",
        "obsidian_get_periodic",
        "obsidian_open_file",
        "obsidian_simple_search",
        "obsidian_search_dataview",
        "obsidian_search_json_logic",
        "obsidian_list_vault_directory",
        "obsidian_list_vault_root",
        "obsidian_status"
      ]
    }
  },
  "disabledMcpServers": [
    "bash",
    "computer",
    "editor",
    "filesystem"
  ],
  "allowedSkills": [
    "claude-design",
    "baoyu-infographic",
    "popular-web-designs",
    "excalidraw",
    "design-md"
  ]
}
