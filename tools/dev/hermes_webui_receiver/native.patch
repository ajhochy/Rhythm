+        raise Denied('invalid local binding')
+    if any(not isinstance(v, str) or not re.fullmatch(r'[A-Za-z0-9_-]{1,128}', v)
+           for v in binding.values()):
+        raise Denied('invalid local binding')
+    return encoded(binding)
