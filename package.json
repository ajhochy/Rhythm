{
  "name": "rhythm",
  "version": "2.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/api_server"
  ],
  "scripts": {
    "workspace-ui:test": "npm --prefix packages/rhythm-workspace-ui run test:all",
    "workspace-ui:build": "npm --prefix packages/rhythm-workspace-ui run build",
    "postinstall": "node -e \"const{execSync}=require('child_process');['darwin-arm64','darwin-x64'].forEach(p=>{try{execSync('chmod +x node_modules/node-pty/prebuilds/'+p+'/spawn-helper')}catch(_){}});\"",
    "build:guard": "python3 tools/build/guard.py --repo .",
    "test:build-storage": "python3 -m unittest discover -s tools/build/test -p \"test_*.py\""
  }
}
